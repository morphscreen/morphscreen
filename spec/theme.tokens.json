    "$type": "fontFamily",
    "sans": {
      "$value": [
        "IBM Plex Sans",
        "IBM Plex Sans Fallback",
        "ui-sans-serif",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "IBM Plex Mono",
        "IBM Plex Mono Fallback",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "type": {
