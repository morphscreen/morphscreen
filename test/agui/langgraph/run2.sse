data: {"type":"STATE_SNAPSHOT","snapshot":{"messages":[{"content":"Quiz me on photosynthesis","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"u1"},{"content":"# Photosynthesis check\n\n<Quiz title=\"Quick check\">\n<Question text=\"What absorbs light in a leaf?\" answer=\"B\" explain=\"Chlorophyll in the chloroplasts absorbs red and blue light.\">\n- A. Stomata\n- B. Chlorophyll\n- C. Xylem\n</Question>\n<Question text=\"Which gas do plants take in?\" answer=\"Carbon dioxide\" explain=\"CO₂ enters through the stomata.\">\n- Oxygen\n- Carbon dioxide\n- Nitrogen\n</Question>\n</Quiz>\n\n<Flashcards title=\"Key terms\">\n| Term | Meaning |\n|---|---|\n| Chlorophyll | The green pigment that absorbs light |\n| Stomata | Pores that let gases in and out |\n| Glucose | The sugar a plant makes |\n</Flashcards>\n\n<Poll label=\"Which topic next?\" options=\"Respiration | Transpiration | Cell division\" name=\"next\" />\n\n<Checklist title=\"Revision plan\" name=\"revision\">\n- [x] Read chapter 4\n- [ ] Draw the leaf diagram\n- [ ] Do the past paper\n</Checklist>\n\n<WhatIf title=\"Order total\">\n<Slider label=\"Price\" min=\"5\" max=\"100\" value=\"20\" />\n<Slider label=\"Quantity\" name=\"qty\" min=\"1\" max=\"10\" value=\"3\" />\n<Slider label=\"Discount (%)\" min=\"0\" max=\"50\" value=\"10\" />\n<Result label=\"Total\" value=\"price * qty * (1 - discount / 100)\" unit=\"$\" decimals=\"2\" />\n<Result label=\"Saved\" value=\"price * qty * discount / 100\" unit=\"$\" decimals=\"2\" />\n</WhatIf>\n","additional_kwargs":{},"response_metadata":{},"type":"ai","name":null,"id":"lc_run--01a14db3-10ec-7871-9d47-d5589ab397ae","tool_calls":[],"invalid_tool_calls":[],"usage_metadata":null},{"content":"I finished the quiz: 1 of 2 right.\n1. What absorbs light in a leaf? I answered \"B. Chlorophyll\" (right).\n2. Which gas do plants take in? I answered \"Oxygen\" (wrong).","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"u2"},{"content":"<Callout tone=\"success\" title=\"Nice work\">\nYou got the quiz back to me. **Respiration** is next.\n</Callout>\n","additional_kwargs":{},"response_metadata":{},"type":"ai","name":null,"id":"lc_run--01a14db3-112a-7fd3-a2fb-8251e9776a80","tool_calls":[],"invalid_tool_calls":[],"usage_metadata":null}],"morphscreen":{"lc_run--01a14db3-10ec-7871-9d47-d5589ab397ae":{"4":{"done":[0,1]}}}}}

